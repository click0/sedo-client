---
# Encrypt:  ansible-vault encrypt vault.yml
# Decrypt:  ansible-vault decrypt vault.yml
# Use:      ansible-playbook ... --ask-vault-pass

# PINs for Windows workers with hardware Almaz-1K tokens
almaz_pins:
  ws01: "ENTER_PIN_HERE"

# PINs per key PROFILE when a worker uses config_local.toml with several keys
# (sedo_keys in hosts.yml). Becomes SEDO_PIN_<PROFILE> on the worker; the
# login key may keep using almaz_pins / SEDO_PIN.
# sedo_key_pins:
#   ws01:
#     login: "ENTER_PIN_HERE"
#     doc: "ENTER_PIN_HERE"

# PINs for Linux workers with virtual tokens (Key-6.dat files)
virtual_pins:
  lin01: "ENTER_PIN_HERE"

# WinRM password for ansible_user on each Windows worker
# (referenced by hosts.yml: ansible_password)
winrm_passwords:
  ws01: "ENTER_WINRM_PASSWORD_HERE"

# Telegram report at the end of both daily playbooks (sedo.telegram_report).
# Leave the whole block out to send nothing. bot_token comes from @BotFather
# ("<digits>:<secret>"); the placeholder below is refused, not sent. chat_id
# is "@channel" or a numeric id; the bot must be a member there. Both go to
# the module as JSON on stdin under no_log, never through the environment.
telegram:
  bot_token: "1234567890:ABCDEF..."
  chat_id: "@your_channel_or_id"
