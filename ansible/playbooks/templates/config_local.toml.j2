{#
  config_local.toml for a worker — generated by Ansible from the inventory.
  Secrets never land here: PINs reach the client as SEDO_PIN_<PROFILE>
  environment variables (sedo_key_pins in the vault), see sedo_daily.yml.

  Inventory shape (host or group vars):
    sedo_keys:
      login: {backend: opensc, module: 'C:\...\PKCS11.EKeyAlmaz1C.dll'}
      doc:   {backend: pkcs11, module: 'C:\...\Av337CryptokiD.dll', cert_id: "02"}
    sedo_roles: {auth: login, sign: doc}
#}
# Generated by Ansible ({{ ansible_managed }}) — edit the inventory, not this file.
{% for name, profile in sedo_keys.items() %}

[keys.{{ name }}]
{% for field, value in profile.items() %}
{{ field }} = {{ value | to_json }}
{% endfor %}
{% endfor %}
{% if sedo_roles is defined %}

[roles]
{% for role, name in sedo_roles.items() %}
{{ role }} = {{ name | to_json }}
{% endfor %}
{% endif %}
